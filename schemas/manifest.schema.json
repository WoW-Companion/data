{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WoW: Forever dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_version", "game_build", "created", "tables"],
  "properties": {
    "dataset_version": { "type": "string", "minLength": 1 },
    "game_build": { "type": "string", "minLength": 1 },
    "created": { "type": "string", "format": "date-time" },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "rows", "sha256", "sort_keys", "sources"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "rows": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sort_keys": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "retrieved", "license"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "retrieved": { "type": "string", "format": "date-time" },
                "license": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
